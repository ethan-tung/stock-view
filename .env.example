# 数据源选择：tencent（默认，腾讯免费行情，覆盖 A股/港股/美股，无需 Key）
DATA_SOURCE=tencent

# 备用：mock（内置模拟数据，无需网络）
# DATA_SOURCE=mock

# 首页右上角徽标显示的数据源名称（公开变量，可随意修改）
NEXT_PUBLIC_DATA_SOURCE_LABEL=实时行情

# ---- 其他真实数据源（示例：TwelveData）----
# 在 lib/sources/registry.ts 中注册实现后，把 DATA_SOURCE 改为对应 id。
# API Key 只在服务端（API Routes）读取，绝不会暴露给浏览器。
# DATA_SOURCE=twelvedata
# TWELVEDATA_API_KEY=your_api_key_here
